DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require"
JWT_SECRET="sua-chave-secreta-longa"

# URL pública do app (WhatsApp / links de receita)
# Em produção na Vercel geralmente não precisa — usa VERCEL_URL.
# NEXT_PUBLIC_APP_URL=https://seu-dominio.vercel.app

# WhatsApp Cloud API (Meta) — envio automático do PDF como documento
# https://developers.facebook.com/docs/whatsapp/cloud-api
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0

# Receituário nativo odontológico (gratuito) — não precisa de Memed.
# Portal oficial CFO (assinatura ICP-Brasil): https://prescricao.cfo.org.br

# API de medicamentos — medicamentos.api.br (Free: 100 req/dia)
# Docs: https://medicamentos.api.br/api/docs
# Gere a key grátis em: https://medicamentos.api.br/api#free
MEDICATION_API_URL=https://southamerica-east1-no-api-br.cloudfunctions.net/apiMedicamentos
MEDICATION_API_KEY=

# Assistente IA do Receituário e busca de procedimentos do orçamento
# Sem nenhuma key: usa catálogo/protocolos locais (gratuito).
#
# Recomendado gratuito (cota mais folgada): Groq
# Key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Alternativa gratuita com pesquisa: Google Gemini (AI Studio)
# Key: https://aistudio.google.com/apikey  (geralmente começa com AIza)
# Na Vercel: Environment Variables → Redeploy após salvar
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# Opcionais pagos:
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# A busca de procedimentos no orçamento e o Assistente IA do Plano de tratamento
# usam as mesmas keys (Groq → Gemini → OpenAI).
# Plano de tratamento: descreva a queixa do paciente → sugestões automáticas de etapas.
# Key gratuita Groq: https://console.groq.com/keys
# Key gratuita Gemini: https://aistudio.google.com/apikey

# Memed — OPCIONAL (voltado a médicos/farmácias; pago)
# MEMED_API_KEY=""
# MEMED_SECRET_KEY=""
# MEMED_ENVIRONMENT="integration"
# MEMED_PRESCRIBER_EXTERNAL_ID=""

# Asaas — recebimentos (PIX / boleto) + webhook
# Sandbox: https://sandbox.asaas.com | Produção: https://www.asaas.com
ASAAS_API_KEY=
# sandbox | producao
ASAAS_AMBIENTE=sandbox
# Token do webhook (header asaas-access-token) — mesmo valor cadastrado no painel Asaas
ASAAS_WEBHOOK_TOKEN=
# URL pública do app (para montar a URL do webhook nas instruções)
# APP_URL=https://seu-dominio.com
# Somente em desenvolvimento, se ainda não houver token:
# WEBHOOK_ALLOW_INSECURE=true
