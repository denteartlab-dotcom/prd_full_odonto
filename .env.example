DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require"
JWT_SECRET="sua-chave-secreta-longa"

# Receituário nativo odontológico (gratuito) — não precisa de Memed.
# Portal oficial CFO (assinatura ICP-Brasil): https://prescricao.cfo.org.br

# API de medicamentos — Bulapi (gratuita, sem autenticação)
# Docs: https://bulapi.com.br  ·  Fonte: ANVISA + CMED
# Se o serviço estiver fora do ar, o sistema usa o catálogo odontológico interno.
MEDICATION_API_URL=https://bulapi.com.br
# MEDICATION_API_DISABLED=1


